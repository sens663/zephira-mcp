{
  "serverInfo": {
    "name": "zephira",
    "title": "Zephira Company Intelligence",
    "version": "1.0.0",
    "websiteUrl": "https://zephira.ai/developers/mcp/"
  },
  "authentication": {
    "required": true,
    "schemes": [
      "bearer"
    ]
  },
  "tools": [
    {
      "name": "search_entities",
      "title": "Search companies",
      "description": "Find companies by name, registration number, VAT number or ticker in a jurisdiction. Requires company:read.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "location": {
            "type": "string",
            "pattern": "^(?:[A-Z]{2}|(?:US|CA|CN)-[A-Z0-9]{2,3}|\\d+(?:_\\d+)+)$",
            "description": "Country code, such as GB; state code, such as US-CA; or KYB location ID."
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "registration_number": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "vat_number": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "ticker": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "city_or_state": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "maxItems": 20
          },
          "include_provenance": {
            "type": "boolean",
            "default": true,
            "description": "Include source metadata where available."
          }
        },
        "required": [
          "location"
        ],
        "anyOf": [
          {
            "required": [
              "name"
            ]
          },
          {
            "required": [
              "registration_number"
            ]
          },
          {
            "required": [
              "vat_number"
            ]
          },
          {
            "required": [
              "ticker"
            ]
          }
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      }
    },
    {
      "name": "get_entity",
      "title": "Get company",
      "description": "Retrieve a company's identity and available profile fields. Requires company:read.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "entity_id": {
            "type": "string",
            "pattern": "^\\d{1,20}$",
            "description": "Numeric company ID returned by search_entities, as a string."
          },
          "include_provenance": {
            "type": "boolean",
            "default": true,
            "description": "Include source metadata where available."
          }
        },
        "required": [
          "entity_id"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      }
    },
    {
      "name": "get_officers",
      "title": "Get company officers",
      "description": "Retrieve a page of available company officers. Requires company:read.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "entity_id": {
            "type": "string",
            "pattern": "^\\d{1,20}$",
            "description": "Numeric company ID returned by search_entities, as a string."
          },
          "include_provenance": {
            "type": "boolean",
            "default": true,
            "description": "Include source metadata where available."
          },
          "page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000,
            "default": 1
          },
          "per_page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "default": 10
          }
        },
        "required": [
          "entity_id"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      }
    },
    {
      "name": "get_shareholders",
      "title": "Get company shareholders",
      "description": "Retrieve a page of available shareholders. Requires ownership:read.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "entity_id": {
            "type": "string",
            "pattern": "^\\d{1,20}$",
            "description": "Numeric company ID returned by search_entities, as a string."
          },
          "include_provenance": {
            "type": "boolean",
            "default": true,
            "description": "Include source metadata where available."
          },
          "page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000,
            "default": 1
          },
          "per_page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "default": 10
          }
        },
        "required": [
          "entity_id"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      }
    },
    {
      "name": "get_corporate_hierarchy",
      "title": "Get corporate hierarchy",
      "description": "Retrieve the full available company group structure. Preserve source and modelled-data labels. Requires ownership:read.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "entity_id": {
            "type": "string",
            "pattern": "^\\d{1,20}$",
            "description": "Numeric company ID returned by search_entities, as a string."
          },
          "include_provenance": {
            "type": "boolean",
            "default": true,
            "description": "Include source metadata where available."
          }
        },
        "required": [
          "entity_id"
        ],
        "additionalProperties": false
      },
      "annotations": {
