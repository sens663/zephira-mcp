    {
      "name": "get_financials",
      "title": "Get company financials",
      "description": "Retrieve available company financial statements and source metadata. Requires financials:read.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "entity_id": {
            "type": "string",
            "pattern": "^\\d{1,20}$",
            "description": "Numeric company ID returned by search_entities, as a string."
          },
          "include_provenance": {
            "type": "boolean",
            "default": true,
            "description": "Include source metadata where available."
          }
        },
        "required": [
          "entity_id"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
